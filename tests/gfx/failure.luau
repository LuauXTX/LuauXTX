local gfx = require("@luauxtx/gfx")
local window, frame
local ok, err = pcall(function()
    gfx.run(function()
        window = gfx.createWindow({width=240,height=120})
        window:onFrame(function()
            frame = window:beginFrame()
            frame:rect({width=30,height=20})
            error("intentional graphics callback error")
        end)
    end)
end)
assert(not ok and tostring(err):find("intentional graphics callback error",1,true),tostring(err))
assert(not window:isOpen())
assert(not pcall(function() frame:clear(0,0,0) end))
print("callback failure released native window and active frame")
