local gfx = require("@luauxtx/gfx")
assert(gfx == require("@luauxtx/gfx"))
local function fails(fn, part)
    local ok, err = pcall(fn)
    assert(not ok and tostring(err):find(part, 1, true), tostring(err))
end
fails(function() gfx.createWindow({}) end, "inside gfx.run")
fails(function() gfx.loadFont(nil, 0) end, "font size")
fails(function() gfx.loadFont(nil, 0/0) end, "font size")
fails(function() gfx.loadFont("does-not-exist.ttf", 16) end, "cannot load font")
fails(function() gfx.loadFont("bad.png", 16) end, "font face")
fails(function() gfx.loadImage("does-not-exist.png") end, "cannot load image")
fails(function() gfx.loadImage("bad.png") end, "decode")
local image = gfx.loadImage("pixel.png")
local width, height = image:getSize()
assert(width == 2 and height == 2)
image:dispose()
image:dispose()
assert(image:isDisposed())
fails(function() image:getSize() end, "disposed")
local font = gfx.loadFont(nil, 18)
local width, height = gfx.measureText("Hello 👋\n世界", font)
assert(width > 0 and height >= 36)
local short = gfx.measureText("Hello", font)
local long = gfx.measureText("Hello World", font)
assert(long > short)
font:dispose()
assert(font:isDisposed())
fails(function() gfx.measureText("x", font) end, "disposed")
print("graphics resource validation passed")
